<?xml version="1.0" encoding="UTF-8"?>
<!--
  白鹿 Goal Runner launchd 配置
  ------------------------------------------------------------
  此文件由 `bailu goal install-launchd` 生成；安装时会替换以下占位：
    __LABEL__              ：服务标签，默认 com.bailu.goal-runner.<project-hash>
    __RUNNER_SH__          ：goal-runner.sh 的绝对路径
    __PROJECT_DIR__        ：项目根目录绝对路径
    __INTERVAL_SECONDS__   ：StartInterval，默认 1800
    __CLAUDE_BIN__         ：CLAUDE_BIN 环境变量，默认 claude
    __LOG_DIR__            ：runner 日志目录，默认 ~/.bailu-goal
    __USER_PATH__          ：用户 PATH，用于让 launchd 找到 claude/node/git
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUNNER_SH__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BAILU_GOAL_PROJECT</key>
    <string>__PROJECT_DIR__</string>
    <key>BAILU_GOAL_HOME</key>
    <string>__LOG_DIR__</string>
    <key>CLAUDE_BIN</key>
    <string>__CLAUDE_BIN__</string>
    <key>PATH</key>
    <string>__USER_PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>StartInterval</key>
  <integer>__INTERVAL_SECONDS__</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
